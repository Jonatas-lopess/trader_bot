---
// Robô details — src/components/robot-details.astro
//
// The body of the "Saiba mais" modal for one Robô (storefront-v2 06, ADR-0008): long
// description, "Detalhes do Robô" rows, the price rows with one buy link and the "Adicionar
// ao carrinho" button, and the 7-day withdrawal note. A coming-soon Robô gets the description
// and rows only: no prices, no buy controls, no note.
//
// Rendered inside each card's `<details data-robot-more>` (robot-card.astro). Without JavaScript
// the details block opens inline, so the long description is never lost; with it, the dialog
// script (robot-dialog.astro) clones this markup into the one <dialog> on demand. No fetch and
// no JSON: every value reaches the page as escaped text from the D1 rows. The buy link carries
// only `robot` + `offer` (ADR-0006). The cart button stays hidden until the cart script
// (src/shared/cart-client.ts) marks the page cart-ready, so it is never a dead control.
//
// Content comes from src/content/catalog-page.ts — see docs/agents/content-files.md.
import {
	addToCartLabel,
	cardBuy,
	cardWithdrawalNote,
	defaultOffer,
	detailsHeading,
	type CatalogCard,
} from '../content/catalog-page';
import RobotInfoRows from './robot-info-rows.astro';
import RobotPriceRows from './robot-price-rows.astro';

type Props = {
	card: CatalogCard;
};

const { card } = Astro.props;
const buy = cardBuy(card);
const offer = defaultOffer(card);
const withdrawalNote = cardWithdrawalNote(card);
---

<div class="flex flex-col gap-6">
	<p class="whitespace-pre-line text-body text-text-secondary">{card.longDescription}</p>

	<div>
		<h3 class="text-caption font-bold uppercase tracking-wider text-text-secondary">{detailsHeading}</h3>
		<div class="mt-3">
			<RobotInfoRows card={card} />
		</div>
	</div>

	{
		buy && offer && (
			<div class="flex flex-col gap-4">
				<RobotPriceRows card={card} />

				<div class="flex flex-col gap-3 sm:flex-row">
					<a
						data-buy
						href={buy.href}
						class="button-h-sm inline-flex shrink-0 items-center justify-center rounded-sm bg-brand-primary px-4 text-body-sm font-medium text-text-on-brand transition-colors hover:bg-brand-primary-hover sm:flex-1"
					>
						{buy.label}
					</a>
					<button
						type="button"
						data-add-to-cart
						data-robot={card.slug}
						data-offer={offer.offer}
						class="button-h-sm hidden shrink-0 items-center justify-center rounded-sm border border-border-subtle px-4 text-body-sm font-medium text-text-primary transition-colors hover:bg-surface-overlay sm:flex-1 in-data-cart-ready:inline-flex"
					>
						{addToCartLabel}
					</button>
				</div>
			</div>
		)
	}

	{
		withdrawalNote && (
			<p class="text-caption text-text-secondary">
				{withdrawalNote.text.value}{' '}
				<a href={withdrawalNote.href} class="font-medium text-brand-primary underline">
					{withdrawalNote.linkLabel}
				</a>
			</p>
		)
	}
</div>
