---
// Catalog route — src/pages/catalog.astro
//
// Replaces `/planos` (.scratch/catalog-pivot/issues/06-catalog-page.md,
// ADR-0006); `/planos` redirects here (astro.config.mjs). Title band, one card
// per published Robô, and the regulatory note, wrapped in the site shell. The
// Robôs are read from D1 on every request (ADR-0008), so the page is not
// prerendered: a Robô published or hidden in the admin shows at once. Copy comes
// from src/content/catalog-page.ts — see docs/agents/content-files.md.
import { env } from 'cloudflare:workers';
import BaseLayout from '../layouts/base-layout.astro';
import CatalogCarousel from '../components/catalog-carousel.astro';
import RobotCard from '../components/robot-card.astro';
import {
	buildCatalogCards,
	emptyCatalogMessage,
	pageDescription,
	pageHeading,
	pageTitle,
	regulatoryNote,
} from '../content/catalog-page';
import { listPublishedWithOffers } from '../modules/catalog/robots';
import { requireAdmin } from '../modules/identity/admin';

export const prerender = false;

// An admin also sees drafts, marked: the preview of a Robô before it is published (ADR-0008).
const admin = await requireAdmin(Astro.request, env);
if (admin.ok) Astro.response.headers.set('Cache-Control', 'private, no-store');
const cards = buildCatalogCards(await listPublishedWithOffers(env, { includeDrafts: admin.ok }));
---

<BaseLayout title={pageTitle} description={pageDescription}>
	<section class="content-row gutter-x py-16 text-center sm:py-20">
		<h1 class="text-heading-1 font-bold text-text-primary">{pageHeading}</h1>
	</section>

	<section class="pb-10">
		{
			cards.length === 0 ? (
				<p class="content-row gutter-x py-10 text-center text-body-lg text-text-secondary">{emptyCatalogMessage}</p>
			) : (
				<CatalogCarousel>
					{cards.map((card) => (
						<li>
							<RobotCard card={card} />
						</li>
					))}
				</CatalogCarousel>
			)
		}
	</section>

	<section class="content-row gutter-x pb-20">
		<p class="mx-auto max-w-3xl text-center text-caption text-text-secondary">{regulatoryNote}</p>
	</section>
</BaseLayout>
