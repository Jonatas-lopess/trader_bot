---
// /conta — the protected customer-area page.
//
// .scratch/customer-area/issues/03-license-status-page.md (Robô/Licença
// display) and 04-cancel-subscription.md (Assinatura status + cancel
// action). Unauthenticated visits redirect to /login (User Story 13); the
// actual session-check guard is ticket 02's `requireSession` (cookie-only,
// no D1 hit), used here via resolveAccountView.
import { env } from 'cloudflare:workers';
import BaseLayout from '../layouts/base-layout.astro';
import { resolveAccountView } from '../modules/licensing/account-page';
import {
	assinaturaLabel,
	assinaturaStatusTexts,
	cancelConfirmMessage,
	cancelLabel,
	heading,
	corretoraAccountHint,
	corretoraAccountLabel,
	corretoraBannerBody,
	corretoraBannerHeading,
	corretoraConfirmMessage,
	corretoraNoticeTexts,
	corretoraSubmitLabel,
	licenseLabel,
	licenseStatusText,
	logoutLabel,
	rejectedNoticeText,
	pageDescription,
	pageTitle,
	robotLabel,
} from '../content/conta';

export const prerender = false;

const view = await resolveAccountView(env, Astro.request);
if (!view.ok) return Astro.redirect('/login');

const licenseText = licenseStatusText(view.license);
const noticeParam = Astro.url.searchParams.get('corretora');
const notice =
	noticeParam !== null && noticeParam in corretoraNoticeTexts
		? corretoraNoticeTexts[noticeParam as keyof typeof corretoraNoticeTexts]
		: null;
const assinaturaStatusText = assinaturaStatusTexts[view.subscriptionStatus];
---

<BaseLayout title={pageTitle} description={pageDescription}>
	<section class="content-row gutter-x flex flex-col gap-6 py-20">
		<h1 class="text-heading-1 font-bold text-text-primary">{heading}</h1>

		{notice !== null && <p class="text-body text-text-secondary" role="status">{notice}</p>}

		{
			view.subscriptionStatus === 'rejected' && (
				<p class="text-body text-text-primary" role="status">
					{rejectedNoticeText.value}
				</p>
			)
		}

		{
			view.license.status === 'awaiting_account' && (
				<section class="flex flex-col gap-4 rounded-md border border-border-subtle p-6" id="corretora-banner">
					<h2 class="text-heading-3 font-bold text-text-primary">{corretoraBannerHeading}</h2>
					<p class="text-body text-text-secondary">{corretoraBannerBody}</p>
					<form method="POST" action="/conta/corretora" id="corretora-form" class="flex max-w-sm flex-col gap-4">
						<label class="flex flex-col gap-2">
							<span class="text-body-sm text-text-secondary">{corretoraAccountLabel}</span>
							<input
								type="text"
								name="corretora_account"
								inputmode="numeric"
								pattern="[1-9][0-9]{0,11}"
								required
								class="rounded-md border border-border-subtle px-4 py-2 text-body text-text-primary"
							/>
							<span class="text-body-sm text-text-secondary">{corretoraAccountHint}</span>
						</label>
						<button
							type="submit"
							class="button-h-lg inline-flex items-center justify-center rounded-md bg-brand-primary px-6 text-body font-medium text-text-on-brand transition-colors hover:bg-brand-primary-hover"
						>
							{corretoraSubmitLabel}
						</button>
					</form>
				</section>
			)
		}

		<dl class="flex flex-col gap-4">
			<div>
				<dt class="text-body-sm text-text-secondary">{robotLabel}</dt>
				<dd class="text-body-lg text-text-primary">{view.robotName}</dd>
			</div>
			<div>
				<dt class="text-body-sm text-text-secondary">{licenseLabel}</dt>
				<dd class="text-body-lg text-text-primary">{licenseText}</dd>
			</div>
			<div>
				<dt class="text-body-sm text-text-secondary">{assinaturaLabel}</dt>
				<dd class="text-body-lg text-text-primary">{assinaturaStatusText}</dd>
			</div>
		</dl>

		{
			view.subscriptionStatus !== 'canceled' && (
				<form method="POST" action="/conta/cancelar" id="cancel-form" class="mt-4">
					<button
						type="submit"
						class="button-h-lg inline-flex items-center justify-center rounded-md border border-border-subtle px-6 text-body font-medium text-text-primary"
					>
						{cancelLabel}
					</button>
				</form>
			)
		}

		<form method="POST" action="/logout">
			<button type="submit" class="text-body-sm text-text-secondary underline">
				{logoutLabel}
			</button>
		</form>
	</section>
</BaseLayout>

<script define:vars={{ cancelConfirmMessage, corretoraConfirmMessage }}>
	// One click plus one confirmation (User Story 10) — a native confirm()
	// dialog is the friction step before the cancel action fires.
	const cancelForm = document.getElementById('cancel-form');
	cancelForm?.addEventListener('submit', (event) => {
		if (!window.confirm(cancelConfirmMessage)) event.preventDefault();
	});

	// The account number is write-once, so confirm before sending it.
	const corretoraForm = document.getElementById('corretora-form');
	corretoraForm?.addEventListener('submit', (event) => {
		if (!window.confirm(corretoraConfirmMessage)) event.preventDefault();
	});
</script>
