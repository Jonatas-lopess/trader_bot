---
// Catalog teaser section — src/components/catalog-teaser.astro
//
// Landing page band below how-it-works (was plan-teaser, frame 6:121;
// .scratch/catalog-pivot/issues/06-catalog-page.md). Badge, heading, one
// condensed card per Robô (name, short description, Compra price) and a
// "Ver catálogo completo" button to /catalog.
//
// Content comes from src/content/catalog-page.ts, which reads from
// src/content/catalog.ts rather than duplicating facts. See
// docs/agents/content-files.md.
import {
	comingSoonLabel,
	teaserBadge,
	teaserCards,
	teaserCtaHref,
	teaserCtaLabel,
	teaserHeading,
} from '../content/catalog-page';
---

<section class="content-row gutter-x py-16 sm:py-20 lg:py-28">
	<div class="mx-auto max-w-2xl text-center">
		<span
			class="badge-h badge-px inline-flex items-center rounded-full border border-border-subtle bg-brand-primary-subtle text-caption font-medium text-brand-primary"
		>
			{teaserBadge}
		</span>

		<h2 class="mt-6 text-heading-1 font-bold text-balance text-text-primary">
			{teaserHeading}
		</h2>
	</div>

	<div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-3">
		{
			teaserCards.map((card) => (
				<div class="flex flex-col rounded-lg border border-border-subtle bg-surface-raised p-8">
					<h3 class="text-heading-3 font-bold text-text-primary">{card.name}</h3>

					<p class="mt-4 text-body-sm text-text-secondary">{card.shortDescription}</p>

					<div class="mt-4 flex items-baseline gap-1">
						{card.fromPriceText ? (
							<span class="text-heading-2 font-bold text-text-primary">{card.fromPriceText}</span>
						) : (
							card.status === 'coming-soon' && (
								<span class="text-body-sm font-medium text-text-secondary">{comingSoonLabel}</span>
							)
						)}
					</div>
				</div>
			))
		}
	</div>

	<div class="mt-12 flex justify-center">
		<a
			href={teaserCtaHref}
			class="button-h-lg inline-flex items-center justify-center rounded-md border border-border-subtle bg-surface-raised px-6 text-body font-medium text-text-primary transition-colors hover:bg-surface-overlay"
		>
			{teaserCtaLabel}
		</a>
	</div>
</section>
