---
// Cart page — src/pages/carrinho.astro
//
// `/carrinho` (storefront-v2 09, ADR-0008). Static HTML plus one script: the cart lives in the
// browser (src/shared/cart-store.ts), so the page cannot render it on the server. The markup is
// the shared cart view (src/components/cart-view.astro, also the header Popover of storefront-v2
// 18); the script (src/shared/cart-page.ts) mounts it.
//
// With scripts on, the header cart icon opens the Popover instead; this page stays as the
// no-JavaScript fallback and the icon's link target.
// Copy comes from src/content/cart.ts — see docs/agents/content-files.md.
import BaseLayout from '../layouts/base-layout.astro';
import CartView from '../components/cart-view.astro';
import { pageDescription, pageHeading, pageTitle } from '../content/cart';
---

<BaseLayout title={pageTitle} description={pageDescription}>
	<section class="content-row gutter-x py-16 text-center sm:py-20">
		<h1 class="text-heading-1 font-bold text-text-primary">{pageHeading}</h1>
	</section>

	<section class="content-row gutter-x pb-20">
		<CartView idPrefix="cart-page" notes data-cart-page class="mx-auto max-w-3xl" />
	</section>
</BaseLayout>

<script>
	import { initCartPage } from '../shared/cart-page';

	initCartPage();
</script>
