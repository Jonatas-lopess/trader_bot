---
// Cart view markup — src/components/cart-view.astro
//
// The cart's four states (loading, empty, error, ready) and the line `<template>`, shared by the
// `/carrinho` page and the header Popover (storefront-v2 09 and 18). src/shared/cart-view.ts
// mounts it, reads the store, asks `POST /cart/summary` for the prices and fills the template with
// text nodes (names are admin-entered, never innerHTML). One state is visible at a time. The
// prices shown are display only; checkout reads the real price again (ADR-0006).
//
// Lines lay out by the width of this box (container queries), not the viewport, so the same
// markup is a row on the page and a column in the Popover. `notes` adds the payment-methods and
// withdrawal notes (the page only; checkout shows the withdrawal note too). Extra attributes land
// on the root, which is how each surface marks its own. `idPrefix` keeps the ids unique when both
// surfaces are on one page. Copy comes from src/content/cart.ts and src/content/catalog-page.ts —
// see docs/agents/content-files.md.
import { Minus, Plus } from '@lucide/astro';
import type { HTMLAttributes } from 'astro/types';
import {
	checkoutLabel,
	continueHref,
	continueLabel,
	emptyCtaLabel,
	emptyMessage,
	errorMessage,
	linesLabel,
	loadingMessage,
	noscriptMessage,
	paymentMethodsNote,
	quantityLabel,
	removeLabel,
	retryLabel,
	totalLabel,
} from '../content/cart';
import { buyWithdrawalNote } from '../content/catalog-page';

interface Props extends HTMLAttributes<'div'> {
	/** Prefix of the ids inside the view, so two views on one page never share one. */
	idPrefix: string;
	notes?: boolean;
}

const { idPrefix, notes = false, class: className = '', ...rest } = Astro.props;

const stepperButton =
	'inline-flex size-9 items-center justify-center rounded-sm border border-border-subtle text-text-primary transition-colors hover:bg-surface-overlay disabled:opacity-40 disabled:hover:bg-transparent';
const primaryButton =
	'button-h-lg inline-flex items-center justify-center rounded-md bg-brand-primary px-6 text-body font-medium text-text-on-brand transition-colors hover:bg-brand-primary-hover';
const outlineButton =
	'button-h-sm inline-flex items-center justify-center rounded-sm border border-border-subtle px-5 text-body-sm font-medium text-text-primary transition-colors hover:bg-surface-overlay';
---

<div data-cart-view tabindex="-1" class:list={['@container outline-none', className]} {...rest}>
	<p data-cart-state="loading" role="status" class="hidden py-10 text-center in-data-cart-ready:block text-body-lg text-text-secondary">
		{loadingMessage}
	</p>
	<noscript>
		<p class="py-10 text-center text-body-lg text-text-secondary">{noscriptMessage}</p>
	</noscript>

	<div data-cart-state="empty" hidden class="flex flex-col items-center gap-6 py-10 text-center">
		<p class="text-body-lg text-text-secondary">{emptyMessage}</p>
		<a
			href={continueHref}
			data-cart-continue
			class={primaryButton}
		>
			{emptyCtaLabel}
		</a>
	</div>

	<div data-cart-state="error" hidden role="alert" class="flex flex-col items-center gap-6 py-10 text-center">
		<p class="text-body-lg text-text-secondary">{errorMessage}</p>
		<button type="button" data-cart-retry class={outlineButton}>{retryLabel}</button>
	</div>

	<div data-cart-state="ready" hidden>
		<ul data-cart-lines aria-label={linesLabel} role="list" class="flex flex-col gap-4"></ul>

		<div class="mt-6 border-t border-border-subtle pt-6 @md:mt-8">
			<p class="flex items-baseline justify-between gap-4">
				<span class="text-body-lg font-bold text-text-primary">{totalLabel}</span>
				<span
					data-cart-total
					aria-live="polite"
					class="whitespace-nowrap font-heading text-heading-2 font-bold text-text-primary"
				></span>
			</p>
			<p id={`${idPrefix}-unavailable-note`} data-cart-unavailable-note hidden class="mt-3 text-body-sm text-danger"></p>
			{
				notes && (
					<>
						<p class="mt-4 text-caption text-text-secondary">{paymentMethodsNote.value}</p>
						<p class="mt-2 text-caption text-text-secondary">
							{buyWithdrawalNote.text.value}{' '}
							<a href={buyWithdrawalNote.href} class="font-medium text-brand-primary underline">
								{buyWithdrawalNote.linkLabel}
							</a>
						</p>
					</>
				)
			}

			<div class="mt-6 flex flex-col gap-3 @md:flex-row @md:justify-between">
				<a href={continueHref} data-cart-continue class={outlineButton}>{continueLabel}</a>
				<a
					data-cart-checkout
					aria-disabled="true"
					class:list={[primaryButton, 'aria-disabled:cursor-not-allowed aria-disabled:opacity-50 aria-disabled:hover:bg-brand-primary']}
				>
					{checkoutLabel}
				</a>
			</div>
		</div>
	</div>

	<!-- One line of the cart, cloned and filled by src/shared/cart-view.ts. -->
	<template data-cart-line-template>
		<li
			data-cart-line
			class="flex flex-col gap-4 rounded-lg border border-border-subtle bg-surface-raised p-4 data-unavailable:border-danger @md:flex-row @md:items-center @md:justify-between @md:p-5"
		>
			<div class="min-w-0">
				<p data-field="name" class="break-words text-body font-bold text-text-primary"></p>
				<p data-field="offer" class="text-caption text-text-secondary"></p>
				<p data-field="unavailable" hidden class="mt-1 text-caption text-danger"></p>
			</div>

			<div class="flex flex-wrap items-center gap-4 @md:flex-nowrap">
				<div data-field="stepper" role="group" aria-label={quantityLabel} class="flex items-center gap-2">
					<button type="button" data-action="decrease" class={stepperButton}>
						<Minus size={16} aria-hidden="true" />
					</button>
					<output data-field="quantity" class="min-w-6 text-center text-body font-medium text-text-primary"></output>
					<button type="button" data-action="increase" class={stepperButton}>
						<Plus size={16} aria-hidden="true" />
					</button>
				</div>

				<div data-field="prices" class="min-w-24 text-right">
					<p data-field="line-price" class="font-heading text-body-lg font-bold text-text-primary"></p>
					<p data-field="unit-price" class="text-caption text-text-secondary"></p>
				</div>

				<button
					type="button"
					data-action="remove"
					class="text-body-sm font-medium text-text-secondary underline transition-colors hover:text-text-primary"
				>
					{removeLabel}
				</button>
			</div>
		</li>
	</template>
</div>
