---
// Robô card — src/components/robot-card.astro
//
// One compact card per Robô on `/catalog` (storefront-v2 07, ADR-0008; replaces the tall
// carousel card drawn 1:1 from `ipa2` in figma-restyle 12, an owner-approved departure of
// 2026-10-12): name, quiet short description, the main price and two actions, "Saiba mais"
// and "Adicionar ao carrinho". The details rows, the selectable price rows and the withdrawal
// note live in the "Saiba mais" modal (robot-details.astro, robot-dialog.astro).
//
// "Saiba mais" is the <summary> of the card's `<details data-robot-more>`: with JavaScript the
// click opens the modal (robot-dialog.astro); without it the details open inline in the card, so
// the long description is never lost. The cart button stays hidden until the cart script
// (src/shared/cart-client.ts) reveals it, so it is never a dead control. It names the Oferta it adds
// (`data-offer`: Compra, else Anual), never a price (ADR-0006). A coming-soon Robô shows its
// badge and "Saiba mais" only.
//
// Content comes from src/content/catalog-page.ts — see docs/agents/content-files.md.
import {
	addToCartLabel,
	cardMainPrice,
	comingSoonLabel,
	defaultOffer,
	draftLabel,
	learnMoreLabel,
	learnMoreLabelFor,
	type CatalogCard,
} from '../content/catalog-page';
import RobotDetails from './robot-details.astro';

type Props = {
	card: CatalogCard;
};

const { card } = Astro.props;
const mainPrice = cardMainPrice(card);
// The cart button adds Compra if offered, else Anual: the card's default Oferta.
const addOffer = defaultOffer(card);
---

<div
	id={card.slug}
	data-robot-card
	class="flex h-full w-full flex-col rounded-lg border border-border-subtle bg-surface-raised card-p-sm"
>
	<div class="flex items-start justify-between gap-3">
		<h2 class="text-body-sm font-bold uppercase tracking-wider text-text-primary">{card.name}</h2>
		{
			card.draft && (
				<span class="inline-flex w-fit shrink-0 items-center rounded-full border border-accent bg-surface-sunken px-3 py-1 text-caption font-medium text-accent">
					{draftLabel}
				</span>
			)
		}
		{
			card.status === 'coming-soon' && (
				<span class="inline-flex w-fit shrink-0 items-center rounded-full border border-border-subtle bg-surface-sunken px-3 py-1 text-caption font-medium text-text-secondary">
					{comingSoonLabel}
				</span>
			)
		}
	</div>

	<p class="mt-2 text-caption text-text-secondary">{card.shortDescription}</p>

	<div class="mt-auto pt-6">
		{
			mainPrice && (
				<p class="flex items-baseline justify-between gap-3">
					<span class="text-caption font-medium text-text-secondary">{mainPrice.label}</span>
					<span class="whitespace-nowrap font-heading text-heading-3 font-bold text-text-primary">
						{mainPrice.priceText}
					</span>
				</p>
			)
		}

		<details data-robot-more data-robot-name={card.name} class:list={[mainPrice && 'mt-4']}>
			<summary
				data-robot-more-trigger
				aria-label={learnMoreLabelFor(card)}
				class="button-h-sm inline-flex w-full cursor-pointer items-center justify-center rounded-sm border border-border-subtle px-4 text-body-sm font-medium text-text-primary transition-colors hover:bg-surface-overlay"
			>
				{learnMoreLabel}
			</summary>
			<div data-robot-more-body class="mt-4">
				<RobotDetails card={card} />
			</div>
		</details>

		{
			addOffer && (
				<button
					type="button"
					data-add-to-cart
					data-robot={card.slug}
					data-offer={addOffer.offer}
					class="button-h-sm mt-3 hidden w-full items-center justify-center rounded-sm bg-brand-primary px-4 text-body-sm font-medium text-text-on-brand transition-colors hover:bg-brand-primary-hover in-data-cart-ready:inline-flex"
				>
					{addToCartLabel}
				</button>
			)
		}
	</div>
</div>
