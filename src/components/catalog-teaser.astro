---
// Catalog teaser section — src/components/catalog-teaser.astro
//
// Landing page band below how-it-works (was plan-teaser, frame 6:121;
// .scratch/catalog-pivot/issues/06-catalog-page.md). Badge, heading and a
// "Ver catálogo completo" button to /catalog. It lists no Robôs or prices: they live
// in D1, and this band keeps the landing prerendered (storefront-v2 03, ADR-0008).
//
// Content comes from src/content/catalog-page.ts. See docs/agents/content-files.md.
import { teaserBadge, teaserCtaHref, teaserCtaLabel, teaserHeading } from '../content/catalog-page';
---

<section class="content-row gutter-x py-16 sm:py-20 lg:py-28">
	<div class="mx-auto max-w-2xl text-center">
		<span
			class="badge-h badge-px inline-flex items-center rounded-full border border-border-subtle bg-brand-primary-subtle text-caption font-medium text-brand-primary"
		>
			{teaserBadge}
		</span>

		<h2 class="mt-6 text-heading-1 font-bold text-balance text-text-primary">
			{teaserHeading}
		</h2>
	</div>

	<div class="mt-12 flex justify-center">
		<a
			href={teaserCtaHref}
			class="button-h-lg inline-flex items-center justify-center rounded-md border border-border-subtle bg-surface-raised px-6 text-body font-medium text-text-primary transition-colors hover:bg-surface-overlay"
		>
			{teaserCtaLabel}
		</a>
	</div>
</section>
