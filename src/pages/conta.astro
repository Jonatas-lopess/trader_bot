---
// /conta — the protected customer-area page.
//
// .scratch/customer-area/issues/03-license-status-page.md (Robô/Licença
// display) and 04-cancel-subscription.md (Assinatura status + cancel
// action). Unauthenticated visits redirect to /login (User Story 13); the
// actual session-check guard is ticket 02's `requireSession` (cookie-only,
// no D1 hit), used here via resolveAccountView.
import { env } from 'cloudflare:workers';
import BaseLayout from '../layouts/base-layout.astro';
import { resolveAccountView } from '../modules/licensing/account-page';
import LicenseCard from '../components/license-card.astro';
import { Server } from '@lucide/astro';
import {
	backendNoteBody,
	backendNoteHeading,
	cancelConfirmMessage,
	corretoraConfirmMessage,
	corretoraNoticeTexts,
	corretoraNoticeTones,
	customerAreaLabel,
	heading,
	logoutLabel,
	pageDescription,
	pageTitle,
} from '../content/conta';

export const prerender = false;

const view = await resolveAccountView(env, Astro.request);
if (!view.ok) return Astro.redirect('/login');

const noticeParam = Astro.url.searchParams.get('corretora');
const noticeKey =
	noticeParam !== null && noticeParam in corretoraNoticeTexts ? (noticeParam as keyof typeof corretoraNoticeTexts) : null;
const notice = noticeKey !== null ? corretoraNoticeTexts[noticeKey] : null;
const noticeToneClass =
	noticeKey !== null && corretoraNoticeTones[noticeKey] === 'success'
		? 'border-success bg-success-subtle'
		: 'border-danger bg-danger-subtle';
---

<BaseLayout title={pageTitle} description={pageDescription}>
	<section class="content-row gutter-x flex flex-col gap-8 py-20">
		<div class="flex flex-wrap items-end justify-between gap-4">
			<div class="flex flex-col gap-2">
				<p class="font-mono text-caption uppercase text-border-accent">{customerAreaLabel}</p>
				<h1 class="text-heading-1 font-bold text-text-primary">{heading}</h1>
			</div>
			<form method="POST" action="/logout">
				<button type="submit" class="text-body-sm text-text-secondary underline transition-colors hover:text-text-primary">
					{logoutLabel}
				</button>
			</form>
		</div>

		{
			notice !== null && (
				<p class={`rounded-md border-w-1 p-4 text-body text-text-primary ${noticeToneClass}`} role="status">
					{notice}
				</p>
			)
		}

		{
			view.robots.map((robot) => (
				<section class="flex flex-col gap-6">
					<h2 class="text-heading-2 font-bold text-text-primary">{robot.robotName}</h2>
					{robot.licenses.map((item) => (
						<LicenseCard item={item} />
					))}
				</section>
			))
		}

		<aside class="flex gap-4 rounded-lg bg-surface-emphasis p-6">
			<Server size={24} class="mt-0.5 shrink-0 text-brand-primary" aria-hidden="true" />
			<div class="flex flex-col gap-1">
				<p class="text-body font-bold text-text-primary">{backendNoteHeading.value}</p>
				<p class="text-body-sm text-text-secondary">{backendNoteBody.value}</p>
			</div>
		</aside>
	</section>
</BaseLayout>

<script define:vars={{ cancelConfirmMessage, corretoraConfirmMessage }}>
	// One click plus one confirmation (User Story 10) — a native confirm()
	// dialog is the friction step before the cancel action fires.
	for (const cancelForm of document.querySelectorAll('[data-cancel-form]')) {
		cancelForm.addEventListener('submit', (event) => {
			if (!window.confirm(cancelConfirmMessage)) event.preventDefault();
		});
	}

	// The account number is write-once, so confirm before sending it.
	for (const corretoraForm of document.querySelectorAll('[data-corretora-form]')) {
		corretoraForm.addEventListener('submit', (event) => {
			if (!window.confirm(corretoraConfirmMessage)) event.preventDefault();
		});
	}
</script>
