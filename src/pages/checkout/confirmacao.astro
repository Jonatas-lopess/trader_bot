---
// Intermediate confirmation page — src/pages/checkout/confirmacao.astro
//
// .scratch/checkout-webhooks/issues/05-intermediate-confirmation-page.md;
// .scratch/appmax-checkout/issues/06-confirmation-page-states.md; PLANNING.md §7 "Checkout
// sequence". Never trusts the redirect alone: resolves the view server-side by `ref` on first
// paint (`getPurchaseView`, the same read `/billing/status` answers from), then a client script
// polls /billing/status every ~2s so a slow or dropped webhook doesn't leave a stale message
// (user story 5). Pix and Boleto instructions come from D1 (written by the pay endpoint), so a
// reload shows them again; they were validated by `getPurchaseView` before reaching this markup.
// A cart is one checkout of several rows (storefront-v2 13): `ref` is the checkout id, the page
// lists every Robô bought and shows one state and one set of Pix/Boleto instructions for the order.
import { env } from 'cloudflare:workers';
import BaseLayout from '../../layouts/base-layout.astro';
import { getPurchaseView } from '../../modules/billing/status';
import { listRobotNames, type OfferName } from '../../modules/catalog/robots';
import { offerLabels } from '../../content/catalog-page';
import {
	activeCtaLabel,
	boletoInstructions,
	boletoOverdueRetryLabel,
	confirmationHeading,
	confirmationMessages,
	formatDeadline,
	formatDueDate,
	missingReferenceMessage,
	newCheckoutHref,
	orderItems,
	pageDescription,
	pageTitle,
	pendingTimeoutMessage,
	pendingTimeoutRetry,
	pixExpiredRetryLabel,
	pixInstructions,
	withdrawalNotice,
} from '../../content/checkout-confirmation';

export const prerender = false;

const reference = Astro.url.searchParams.get('ref');
const initial = await getPurchaseView(env, reference);
const view = initial.ok ? initial.view : null;
const pix = view?.instructions?.kind === 'pix' ? view.instructions : null;
const boleto = view?.instructions?.kind === 'boleto' ? view.instructions : null;
const retryHref = newCheckoutHref(view?.items ?? []);
// Names are read for display only (an archived Robô keeps its name; an unknown slug shows as is).
const names = view === null ? new Map<string, string>() : await listRobotNames(env);
const items = (view?.items ?? []).map((item) => ({
	name: names.get(item.robotId) ?? item.robotId,
	detail: orderItems.detail(offerLabels[item.offer as OfferName] ?? item.offer, item.quantity),
}));

// Which states show which block; the script toggles `hidden` from `data-show-on` as the poll moves.
const PIX_STATES = 'awaiting_pix';
const PIX_EXPIRED_STATES = 'pix_expired';
const BOLETO_STATES = 'awaiting_boleto boleto_overdue';
const BOLETO_OVERDUE_STATES = 'boleto_overdue';
const isShownOn = (states: string) => view !== null && states.split(' ').includes(view.state);

const copyButtonClass =
	'button-h-sm inline-flex items-center justify-center self-start rounded-md border-w-1 border-border-high-contrast bg-surface-raised px-4 text-body-sm font-medium text-text-primary transition-colors hover:border-border-accent';
const codeClass =
	'w-full resize-none break-all rounded-md border-w-1 border-border-subtle bg-surface-sunken px-3 py-2 font-mono text-body-sm text-text-primary';
---

<BaseLayout title={pageTitle} description={pageDescription}>
	<section class="content-row gutter-x flex flex-col items-center gap-6 py-20 text-center">
		<h1 class="text-heading-1 font-bold text-text-primary">{confirmationHeading}</h1>

		{
			view === null ? (
				<p class="text-body-lg text-text-secondary">{missingReferenceMessage}</p>
			) : (
				<div id="confirmation-root" data-ref={reference} data-state={view.state} class="flex w-full max-w-xl flex-col items-center gap-4">
					<p id="confirmation-message" role="status" class="text-body-lg text-text-secondary">
						{confirmationMessages[view.state]}
					</p>

					<section aria-labelledby="confirmation-items-heading" class="flex w-full flex-col gap-3 rounded-md border-w-1 border-border-subtle bg-surface-raised p-6 text-left">
						<h2 id="confirmation-items-heading" class="text-heading-3 font-bold text-text-primary">{orderItems.heading}</h2>
						<ul role="list" class="flex flex-col gap-2">
							{items.map((item) => (
								<li class="flex flex-col">
									<span class="break-words text-body font-medium text-text-primary">{item.name}</span>
									<span class="text-body-sm text-text-secondary">{item.detail}</span>
								</li>
							))}
						</ul>
					</section>

					{pix && (
						<div data-show-on={PIX_STATES} hidden={!isShownOn(PIX_STATES)} class="flex w-full flex-col items-center gap-4 rounded-md border-w-1 border-border-subtle bg-surface-raised p-6">
							{pix.qrSrc && <img src={pix.qrSrc} alt={pixInstructions.qrAlt} width="220" height="220" class="size-[220px] rounded-sm bg-surface-base" />}
							{pix.expiresAt && (
								<p class="text-body text-text-primary">
									{pixInstructions.deadlineLabel}: <strong>{formatDeadline(pix.expiresAt)}</strong>
								</p>
							)}
							{pix.emvCode && (
								<div class="flex w-full flex-col gap-2 text-left">
									<label for="pix-code" class="text-body-sm text-text-secondary">
										{pixInstructions.codeLabel}
									</label>
									<textarea id="pix-code" readonly rows="4" class={codeClass}>{pix.emvCode}</textarea>
									<button
										type="button"
										data-copy-target="pix-code"
										data-copied-label={pixInstructions.copiedLabel}
										data-failed-label={pixInstructions.copyFailedLabel}
										class={copyButtonClass}
									>
										{pixInstructions.copyLabel}
									</button>
								</div>
							)}
						</div>
					)}

					{pix && (
						<a
							data-show-on={PIX_EXPIRED_STATES}
							hidden={!isShownOn(PIX_EXPIRED_STATES)}
							href={retryHref}
							class="button-h-lg inline-flex items-center justify-center rounded-md bg-brand-primary px-6 text-body font-medium text-text-on-brand transition-colors hover:bg-brand-primary-hover"
						>
							{pixExpiredRetryLabel}
						</a>
					)}

					{boleto && (
						<div data-show-on={BOLETO_STATES} hidden={!isShownOn(BOLETO_STATES)} class="flex w-full flex-col items-center gap-4 rounded-md border-w-1 border-border-subtle bg-surface-raised p-6">
							{boleto.dueDate && (
								<p class="text-body text-text-primary">
									{boletoInstructions.dueLabel}: <strong>{formatDueDate(boleto.dueDate)}</strong>
								</p>
							)}
							{boleto.pdfUrl && (
								<a
									href={boleto.pdfUrl}
									target="_blank"
									rel="noopener noreferrer"
									class="button-h-lg inline-flex items-center justify-center rounded-md bg-brand-primary px-6 text-body font-medium text-text-on-brand transition-colors hover:bg-brand-primary-hover"
								>
									{boletoInstructions.pdfLabel}
								</a>
							)}
							{boleto.digitableLine && (
								<div class="flex w-full flex-col gap-2 text-left">
									<label for="boleto-line" class="text-body-sm text-text-secondary">
										{boletoInstructions.lineLabel}
									</label>
									<textarea id="boleto-line" readonly rows="2" class={codeClass}>{boleto.digitableLine}</textarea>
									<button
										type="button"
										data-copy-target="boleto-line"
										data-copied-label={boletoInstructions.copiedLabel}
										data-failed-label={boletoInstructions.copyFailedLabel}
										class={copyButtonClass}
									>
										{boletoInstructions.copyLabel}
									</button>
								</div>
							)}
							<a
								data-show-on={BOLETO_OVERDUE_STATES}
								hidden={!isShownOn(BOLETO_OVERDUE_STATES)}
								href={retryHref}
								class="text-body font-medium text-brand-primary underline"
							>
								{boletoOverdueRetryLabel}
							</a>
						</div>
					)}

					{/* Login destination out of scope (checkout-confirmation.ts) — inert,
					   never <a href="#">. */}
					<span
						id="confirmation-cta"
						class="button-h-lg mt-4 hidden items-center justify-center rounded-md bg-brand-primary px-6 text-body font-medium text-text-on-brand data-[visible]:inline-flex"
					>
						{activeCtaLabel}
					</span>
					{/* The 7-day withdrawal (withdrawal-guarantee 03); shown on the paid state only, like the CTA. */}
					<p
						id="confirmation-withdrawal"
						class="mt-4 hidden max-w-xl text-body-sm text-text-secondary data-[visible]:block"
					>
						{withdrawalNotice.text.value}{' '}
						<a href={withdrawalNotice.supportLink.href} class="font-medium text-brand-primary underline">
							{withdrawalNotice.supportLink.label}
						</a>
						{' · '}
						<a href={withdrawalNotice.termosLink.href} class="font-medium text-brand-primary underline">
							{withdrawalNotice.termosLink.label}
						</a>
					</p>
					{/* Shown only once a `pending` wait times out; starts a new checkout, never resumes this row. */}
					<a
						id="confirmation-retry"
						href={pendingTimeoutRetry.href}
						class="mt-4 hidden text-body font-medium text-brand-primary underline data-[visible]:inline-block"
					>
						{pendingTimeoutRetry.label}
					</a>
				</div>
			)
		}
	</section>
</BaseLayout>

<script>
	const root = document.getElementById('confirmation-root');
	if (root) {
		const reference = root.dataset.ref;
		const messageEl = document.getElementById('confirmation-message');
		const ctaEl = document.getElementById('confirmation-cta');
		const retryEl = document.getElementById('confirmation-retry');
		const withdrawalEl = document.getElementById('confirmation-withdrawal');
		const stateBlocks = Array.from(root.querySelectorAll<HTMLElement>('[data-show-on]'));

		// PLANNING.md §7: ~2s interval, no WebSocket, no Durable Object.
		const POLL_INTERVAL_MS = 2000;

		// No server-side timeout — the webhook is still the only thing that
		// flips the row (PLANNING.md §7). This only swaps the on-screen copy
		// after a long wait; polling keeps running underneath so a late webhook
		// still resolves the page automatically. Pix and Boleto carry their own
		// deadline instead.
		const PENDING_TIMEOUT_MS = 5 * 60 * 1000;
		const TIMEOUT_STATES = ['pending', 'card_in_review'];
		const pollStartedAt = Date.now();

		const messages: Record<string, string> = JSON.parse(
			document.getElementById('confirmation-messages-data')?.textContent ?? '{}'
		);
		const timeoutMessage: string = JSON.parse(
			document.getElementById('confirmation-timeout-message-data')?.textContent ?? '""'
		);

		const applyState = (state: string) => {
			root.setAttribute('data-state', state);
			if (messageEl && messages[state]) {
				const timedOut = TIMEOUT_STATES.includes(state) && Date.now() - pollStartedAt >= PENDING_TIMEOUT_MS;
				const text = timedOut && timeoutMessage ? timeoutMessage : messages[state];
				if (messageEl.textContent !== text) messageEl.textContent = text;
				if (retryEl) {
					if (timedOut) retryEl.setAttribute('data-visible', '');
					else retryEl.removeAttribute('data-visible');
				}
			}
			for (const block of stateBlocks) block.hidden = !(block.dataset.showOn ?? '').split(' ').includes(state);
			if (ctaEl) {
				if (state === 'active') ctaEl.setAttribute('data-visible', '');
				else ctaEl.removeAttribute('data-visible');
			}
			if (withdrawalEl) {
				if (state === 'active') withdrawalEl.setAttribute('data-visible', '');
				else withdrawalEl.removeAttribute('data-visible');
			}
		};

		// Reflects whatever state the server already resolved on first
		// paint — without this, a page landed on already `active` (the
		// common case: card payments confirm before the redirect
		// completes) never shows the CTA, since `poll`'s own `active`
		// guard below returns before ever calling `applyState`.
		applyState(root.dataset.state ?? 'pending');

		// Copy buttons: the clipboard API, falling back to selecting the whole code so the Cliente
		// can copy it by hand.
		for (const button of Array.from(root.querySelectorAll<HTMLButtonElement>('[data-copy-target]'))) {
			const field = document.getElementById(button.dataset.copyTarget ?? '') as HTMLTextAreaElement | null;
			const label = button.textContent ?? '';
			button.addEventListener('click', async () => {
				if (!field) return;
				try {
					await navigator.clipboard.writeText(field.value);
					button.textContent = button.dataset.copiedLabel ?? label;
				} catch {
					field.focus();
					field.select();
					button.textContent = button.dataset.failedLabel ?? label;
				}
				setTimeout(() => (button.textContent = label), 4000);
			});
		}

		const poll = async () => {
			if (root.getAttribute('data-state') === 'active') return; // confirmed, stop polling
			try {
				const response = await fetch(`/billing/status?ref=${encodeURIComponent(reference ?? '')}`);
				if (!response.ok) return;
				const body: { status: string } = await response.json();
				applyState(body.status);
			} catch {
				// Transient network error — next poll tries again.
			}
		};

		setInterval(poll, POLL_INTERVAL_MS);
	}
</script>

<script id="confirmation-messages-data" type="application/json" set:html={JSON.stringify(confirmationMessages)} />
<script id="confirmation-timeout-message-data" type="application/json" set:html={JSON.stringify(pendingTimeoutMessage)} />
