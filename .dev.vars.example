APPMAX_CLIENT_ID=
APPMAX_CLIENT_SECRET=
# Selects Appmax's hosts (modules/billing/appmax-client.ts): only the literal
# "production" hits production money; unset or anything else is sandbox.
APPMAX_ENV=
# The Appmax app installation id for Appmax JS on /checkout (ADR-0007). Differs per
# environment and must match APPMAX_ENV, or Appmax answers 404 "Merchant not found".
APPMAX_EXTERNAL_ID=
APPMAX_WEBHOOK_IPS=
RESEND_API_KEY=
SESSION_SECRET=
# Test-env-only: enables GET /login/dev?email=&key= (login without the magic-link e-mail,
# for while Resend's shared sender only delivers to the account owner). Never set in production.
DEV_LOGIN_KEY=
# Comma-separated e-mails allowed into /admin (modules/identity/admin.ts); an allowlisted
# address can request a magic link without ever having bought. Unset or empty locks everyone out.
ADMIN_EMAILS=
# Unset ships fine — Sentry.withSentry gates on this being present
# (sentry.server.config.ts), same convention as Appmax/Resend above.
SENTRY_DSN=
# Tags captured events so the dashboard can tell deploys apart. Unset falls
# back to 'unconfigured' (src/shared/sentry-environment.ts) rather than
# Sentry's own 'production' default.
SENTRY_ENVIRONMENT=
# Test-only stopgap (docs/adr/0005-stripe-test-driver.md) — leave unset/appmax
# unless you're testing checkout locally against Stripe while Appmax
# onboarding is blocked. Never set to stripe in a deployed environment.
PAYMENT_PROVIDER=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Where Encomenda (custom-Robô) requests are e-mailed (modules/orders/encomenda.ts). Unset
# still stores the lead and logs a warning.
ORDER_NOTIFY_EMAIL=
# Digits only, country code first (5511999999999). Target of the "Continuar no WhatsApp" link;
# unset falls back to the launch-blocking placeholder in src/content/encomenda.ts.
WHATSAPP_NUMBER=
