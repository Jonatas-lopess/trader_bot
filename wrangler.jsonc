{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "trader-bot",
	"compatibility_date": "2026-09-23",
	// Astro's Cloudflare adapter (SSR-capable) needs both flags — see
	// PLANNING.md §3 and ADR-0002, even though 0.1 ships prerendered-only.
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": "./dist/client"
	},
	"observability": {
		"enabled": true
	}
}
