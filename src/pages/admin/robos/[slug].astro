---
// /admin/robos/<slug> — edit a Robô: fields, Ofertas and status, then its gallery.
//
// .scratch/storefront-v2/issues/05-admin-catalog-crud.md. GET shows the stored values (the
// slug read-only once a purchase references it); POST saves through `updateRobot` and
// redirects with a flash (303), or re-renders with the typed values and field errors (422).
// An unknown slug is a plain 404, like every non-admin result.
//
// Below the form sits the gallery (.scratch/robot-gallery/spec.md, admin-gallery.astro): its own
// forms post to `/admin/robos/<slug>/galeria/*` and come back here at `#galeria` with `?ok=` or
// `?error=`, looked up in src/content/admin.ts (nothing typed is reflected).
import { env } from 'cloudflare:workers';
import AdminGallery from '../../../components/admin-gallery.astro';
import AdminRobotForm from '../../../components/admin-robot-form.astro';
import ConfirmDialog from '../../../components/confirm-dialog.astro';
import BaseLayout from '../../../layouts/base-layout.astro';
import {
	getRobotForAdmin,
	isSlugLocked,
	readRobotForm,
	toFormInput,
	updateRobot,
	type FieldErrors,
} from '../../../modules/catalog/admin';
import { listGallery } from '../../../modules/catalog/gallery';
import { gateAdmin } from '../../../modules/identity/admin';
import {
	backToListLabel,
	editRobotHeading,
	flashText,
	galleryErrorText,
	galleryFlashText,
	robotsPageDescription,
	saveSubmitLabel,
	viewPublicLabel,
} from '../../../content/admin';

export const prerender = false;

const gate = await gateAdmin(Astro.request, env, { checkOrigin: true, headers: Astro.response.headers });
if (!gate.ok) return gate.response;

const slug = Astro.params.slug ?? '';
const robot = await getRobotForAdmin(env, slug);
if (!robot) return new Response(null, { status: 404 });
const slugLocked = await isSlugLocked(env, slug);

let values = toFormInput(robot);
let errors: FieldErrors = {};

if (Astro.request.method === 'POST') {
	values = readRobotForm(await Astro.request.formData());
	const result = await updateRobot(env, slug, values);
	if (result === null) return new Response(null, { status: 404 });
	if (result.ok) return Astro.redirect(`/admin/robos/${result.slug}?ok=saved`, 303);
	errors = result.errors;
	Astro.response.status = 422;
}

const okParam = Astro.url.searchParams.get('ok');
const flash = flashText(okParam);
const galleryFlash = galleryFlashText(okParam);
const galleryError = galleryErrorText(Astro.url.searchParams.get('error'));
const galleryItems = await listGallery(env, slug);
const heading = editRobotHeading(robot.name);
---

<BaseLayout title={heading} description={robotsPageDescription} shell="admin">
	<section class="content-row gutter-x flex flex-col gap-8 py-12 sm:py-16">
		<div class="flex flex-col gap-2">
			<a href="/admin/robos" class="w-fit text-body-sm text-text-secondary transition-colors hover:text-text-primary">{backToListLabel}</a>
			<h1 class="text-heading-1 font-bold text-text-primary">{heading}</h1>
			<a href="/catalog" class="w-fit text-body-sm text-brand-primary transition-colors hover:text-brand-primary-hover">{viewPublicLabel}</a>
		</div>

		{flash && <p class="max-w-3xl rounded-md border-w-1 border-success bg-success-subtle p-4 text-body text-text-primary" role="status">{flash}</p>}

		<AdminRobotForm values={values} errors={errors} mode="edit" slugLocked={slugLocked} submitLabel={saveSubmitLabel} />

		<AdminGallery slug={slug} items={galleryItems} flash={galleryFlash} error={galleryError} />
	</section>

	<ConfirmDialog />
</BaseLayout>
