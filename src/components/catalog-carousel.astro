---
// Catalog carousel — src/components/catalog-carousel.astro
//
// Lays out the Robô cards on `/catalog` as a scroll-snap track. The card
// nearest the track's centre is highlighted like the original plans design
// (brand border, glow, slightly larger). With few cards the track doesn't
// overflow and the cards simply sit centred; with more, the track scrolls
// (swipe, wheel, arrows, or keyboard) and the highlight follows the centre.
// No highlight with fewer than three cards: there is no "central" one.
//
// Below `sm` the arrows are hidden: they would sit on the card text, and a
// swipe scrolls the track natively.
//
// Labels come from src/content/catalog-page.ts — docs/agents/content-files.md.
import { ChevronLeft, ChevronRight } from '@lucide/astro';
import { carouselLabel, carouselNextLabel, carouselPrevLabel } from '../content/catalog-page';
---

<div data-carousel class="content-row relative">
	<button
		type="button"
		data-carousel-prev
		aria-label={carouselPrevLabel}
		class="absolute left-2 top-1/2 z-10 hidden max-sm:hidden! h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full border border-border-subtle bg-surface-raised text-text-primary transition-colors hover:bg-surface-overlay"
	>
		<ChevronLeft aria-hidden="true" />
	</button>

	<ul
		data-carousel-track
		role="list"
		aria-label={carouselLabel}
		tabindex="0"
		class="carousel-track flex snap-x snap-mandatory items-stretch gap-6 overflow-x-auto scroll-smooth px-4 py-10 sm:px-8"
	>
		<slot />
	</ul>

	<button
		type="button"
		data-carousel-next
		aria-label={carouselNextLabel}
		class="absolute right-2 top-1/2 z-10 hidden max-sm:hidden! h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full border border-border-subtle bg-surface-raised text-text-primary transition-colors hover:bg-surface-overlay"
	>
		<ChevronRight aria-hidden="true" />
	</button>
</div>

<style is:global>
	.carousel-track {
		scrollbar-width: none;
	}
	.carousel-track::-webkit-scrollbar {
		display: none;
	}
	/* margin:auto on the ends centres a short row yet keeps overflow scrollable from the start. */
	.carousel-track > li:first-child {
		margin-inline-start: auto;
	}
	.carousel-track > li:last-child {
		margin-inline-end: auto;
	}
	.carousel-track > li {
		display: flex;
		flex: 0 0 min(85%, 22rem);
		scroll-snap-align: center;
		transition:
			transform 200ms ease,
			opacity 200ms ease;
	}
	.carousel-track > li > * {
		flex: 1;
		transition:
			border-color 200ms ease,
			box-shadow 200ms ease;
	}
	.carousel-track[data-highlight] > li[data-active] {
		transform: scale(1.05);
	}
	.carousel-track[data-highlight] > li[data-active] > * {
		border-color: var(--color-brand-primary);
		box-shadow: var(--shadow-glow-brand);
	}
	@media (prefers-reduced-motion: reduce) {
		.carousel-track {
			scroll-behavior: auto;
		}
		.carousel-track > li,
		.carousel-track > li > * {
			transition: none;
		}
	}
</style>

<script>
	for (const root of document.querySelectorAll<HTMLElement>('[data-carousel]')) {
		const track = root.querySelector<HTMLElement>('[data-carousel-track]');
		const prev = root.querySelector<HTMLButtonElement>('[data-carousel-prev]');
		const next = root.querySelector<HTMLButtonElement>('[data-carousel-next]');
		if (!track) continue;
		const items = Array.from(track.children) as HTMLElement[];

		const update = () => {
			const overflowing = track.scrollWidth > track.clientWidth + 1;
			for (const btn of [prev, next]) {
				btn?.classList.toggle('hidden', !overflowing);
				btn?.classList.toggle('inline-flex', overflowing);
			}
			if (items.length < 3) return;
			track.toggleAttribute('data-highlight', true);
			const mid = track.scrollLeft + track.clientWidth / 2;
			let best = items[0];
			for (const item of items) {
				const d = Math.abs(item.offsetLeft + item.offsetWidth / 2 - mid);
				if (d < Math.abs(best.offsetLeft + best.offsetWidth / 2 - mid)) best = item;
			}
			for (const item of items) item.toggleAttribute('data-active', item === best);
			if (prev) prev.disabled = track.scrollLeft <= 1;
			if (next) next.disabled = track.scrollLeft + track.clientWidth >= track.scrollWidth - 1;
		};

		const step = (dir: 1 | -1) => {
			const first = items[0];
			const width = first ? first.offsetWidth + 24 : track.clientWidth;
			track.scrollBy({ left: dir * width });
		};

		prev?.addEventListener('click', () => step(-1));
		next?.addEventListener('click', () => step(1));
		track.addEventListener('keydown', (e) => {
			if (e.key === 'ArrowRight') step(1);
			else if (e.key === 'ArrowLeft') step(-1);
			else return;
			e.preventDefault();
		});
		track.addEventListener('scroll', () => requestAnimationFrame(update), { passive: true });
		window.addEventListener('resize', update);
		update();
	}
</script>
