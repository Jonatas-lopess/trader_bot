---
// Legal text in a modal — src/components/legal-dialog.astro
//
// Termos de uso / Política de privacidade shown over the customer area instead of leaving it.
// Same sections as the standalone routes (src/components/legal-page.astro); the links in
// account-footer.astro keep their `href`, so without JS they still open the page. Opened by
// `[data-legal-dialog="<id>"]` links, wired in account-footer.astro.
import type { LegalPage } from '../content/legal';
import { legalDialogCloseLabel } from '../content/footer';

interface Props {
	page: LegalPage;
	id: string;
}

const { page, id } = Astro.props;
---

<dialog
	id={id}
	aria-labelledby={`${id}-title`}
	class="m-auto max-h-[85dvh] w-[calc(100%-2.5rem)] max-w-2xl overflow-y-auto rounded-lg border-w-1 border-border-subtle bg-surface-raised p-0 text-text-primary shadow-card backdrop:bg-surface-base/80"
>
	<div class="sticky top-0 flex items-center justify-between gap-4 border-b border-border-subtle bg-surface-raised px-6 py-4">
		<h2 id={`${id}-title`} class="text-heading-3 font-bold text-text-primary">{page.heading}</h2>
		<button
			type="button"
			data-legal-close
			class="button-h-sm inline-flex items-center justify-center rounded-md border-w-1 border-border-strong px-4 text-body-sm font-medium text-text-primary transition-colors hover:bg-surface-overlay"
		>
			{legalDialogCloseLabel}
		</button>
	</div>
	<div class="flex flex-col gap-8 px-6 py-6">
		{
			page.sections.map((section) => (
				<section>
					<h3 class="text-body-lg font-bold text-text-primary">{section.heading}</h3>
					<p class="mt-2 text-body text-text-secondary">{section.body.value}</p>
				</section>
			))
		}
	</div>
</dialog>
