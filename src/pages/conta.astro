---
// /conta — the protected customer-area page.
//
// .scratch/customer-area/issues/03-license-status-page.md. Unauthenticated
// visits redirect to /login (User Story 13); the actual session-check guard
// is ticket 02's `requireSession` (cookie-only, no D1 hit), used here via
// resolveAccountView.
import { env } from 'cloudflare:workers';
import BaseLayout from '../layouts/base-layout.astro';
import { resolveAccountView } from '../modules/licensing/account-page';
import {
	cancelLabel,
	heading,
	licenseActiveText,
	licenseLabel,
	licensePreparingText,
	logoutLabel,
	pageDescription,
	pageTitle,
	planLabel,
} from '../content/conta';

export const prerender = false;

const view = await resolveAccountView(env, Astro.request);
if (!view.ok) return Astro.redirect('/login');

const licenseText =
	view.license.status === 'active' ? licenseActiveText(view.license.expiresAt) : licensePreparingText;
---

<BaseLayout title={pageTitle} description={pageDescription}>
	<section class="content-row gutter-x flex flex-col gap-6 py-20">
		<h1 class="text-heading-1 font-bold text-text-primary">{heading}</h1>

		<dl class="flex flex-col gap-4">
			<div>
				<dt class="text-body-sm text-text-secondary">{planLabel}</dt>
				<dd class="text-body-lg text-text-primary">{view.planName}</dd>
			</div>
			<div>
				<dt class="text-body-sm text-text-secondary">{licenseLabel}</dt>
				<dd class="text-body-lg text-text-primary">{licenseText}</dd>
			</div>
		</dl>

		<!-- Ticket 04 (.scratch/customer-area/issues/04-cancel-subscription.md)
		     wires the confirm step and the cancel action itself onto this
		     shell; this ticket only renders it. -->
		<form method="POST" action="/conta/cancelar" class="mt-4">
			<button
				type="submit"
				class="button-h-lg inline-flex items-center justify-center rounded-md border border-border-subtle px-6 text-body font-medium text-text-primary"
			>
				{cancelLabel}
			</button>
		</form>

		<form method="POST" action="/logout">
			<button type="submit" class="text-body-sm text-text-secondary underline">
				{logoutLabel}
			</button>
		</form>
	</section>
</BaseLayout>
