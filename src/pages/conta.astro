---
// /conta — the protected customer-area page.
//
// .scratch/customer-area/issues/03-license-status-page.md (Robô/Licença
// display) and 04-cancel-subscription.md (Assinatura status + cancel
// action). Unauthenticated visits redirect to /login (User Story 13); the
// actual session-check guard is ticket 02's `requireSession` (cookie-only,
// no D1 hit), used here via resolveAccountView.
import { env } from 'cloudflare:workers';
import BaseLayout from '../layouts/base-layout.astro';
import { resolveAccountView } from '../modules/licensing/account-page';
import LicenseCard from '../components/license-card.astro';
import ConfirmDialog from '../components/confirm-dialog.astro';
import { CircleCheck, Headphones, Server } from '@lucide/astro';
import {
	activeLicensesText,
	backendNoteBody,
	backendNoteHeading,
	corretoraNoticeTexts,
	corretoraNoticeTones,
	heading,
	pageDescription,
	pageTitle,
	subheading,
	supportButtonLabel,
	supportCardBody,
	supportCardHeading,
} from '../content/conta';
import { supportMailto } from '../content/support';

export const prerender = false;

const view = await resolveAccountView(env, Astro.request);
if (!view.ok) return Astro.redirect('/login');

// One flat grid of cards; the view keeps a Robô's Licenças adjacent (order of first purchase).
const cards = view.robots.flatMap((robot) => robot.licenses.map((item) => ({ robotName: robot.robotName, item })));
const activeCount = cards.filter(({ item }) => item.license.status === 'active').length;

const noticeParam = Astro.url.searchParams.get('corretora');
const noticeKey =
	noticeParam !== null && noticeParam in corretoraNoticeTexts ? (noticeParam as keyof typeof corretoraNoticeTexts) : null;
const notice = noticeKey !== null ? corretoraNoticeTexts[noticeKey] : null;
const noticeToneClass =
	noticeKey !== null && corretoraNoticeTones[noticeKey] === 'success'
		? 'border-success bg-success-subtle'
		: 'border-danger bg-danger-subtle';
---

<BaseLayout title={pageTitle} description={pageDescription} shell="account">
	<section class="content-row gutter-x flex flex-col gap-8 py-12 sm:py-16">
		<div class="flex flex-wrap items-end justify-between gap-4">
			<div class="flex flex-col gap-2">
				<h1 class="text-heading-1 font-bold text-text-primary">{heading}</h1>
				<p class="text-body text-text-secondary">{subheading}</p>
			</div>
			{
				activeCount > 0 && (
					<span class="inline-flex items-center gap-1.5 rounded-xs bg-success-subtle px-2 py-1 font-mono text-caption text-success">
						<CircleCheck size={14} aria-hidden="true" />
						{activeLicensesText(activeCount)}
					</span>
				)
			}
		</div>

		{
			notice !== null && (
				<p class={`rounded-md border-w-1 p-4 text-body text-text-primary ${noticeToneClass}`} role="status">
					{notice}
				</p>
			)
		}

		<div class="grid items-start gap-6 lg:grid-cols-[minmax(0,1fr)_20rem]">
			<div class="grid items-start gap-4 md:grid-cols-2">
				{cards.map(({ robotName, item }) => <LicenseCard item={item} robotName={robotName} />)}
			</div>

			<div class="flex flex-col gap-4">
				<aside class="flex flex-col gap-4 rounded-lg border-w-1 border-border-subtle bg-surface-raised p-5 shadow-card">
					<div class="flex items-center gap-3">
						<Headphones size={20} class="shrink-0 text-brand-primary" aria-hidden="true" />
						<h2 class="text-body-lg font-bold text-text-primary">{supportCardHeading.value}</h2>
					</div>
					<p class="text-body-sm text-text-secondary">{supportCardBody.value}</p>
					<a
						href={supportMailto()}
						class="button-h-sm inline-flex items-center justify-center rounded-md border-w-1 border-border-subtle text-body-sm font-medium text-text-primary transition-colors hover:bg-surface-overlay"
					>
						{supportButtonLabel}
					</a>
				</aside>

				<aside class="flex gap-3 rounded-lg bg-surface-emphasis p-5">
					<Server size={20} class="mt-0.5 shrink-0 text-brand-primary" aria-hidden="true" />
					<div class="flex flex-col gap-1">
						<p class="text-body-sm font-bold text-text-primary">{backendNoteHeading.value}</p>
						<p class="text-caption text-text-secondary">{backendNoteBody.value}</p>
					</div>
				</aside>
			</div>
		</div>
	</section>
	<ConfirmDialog />
</BaseLayout>
