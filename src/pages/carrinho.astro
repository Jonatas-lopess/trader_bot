---
// Cart page — src/pages/carrinho.astro
//
// `/carrinho` (storefront-v2 09, ADR-0008). Static HTML plus one script: the cart lives in the
// browser (src/shared/cart-store.ts), so the page cannot render it on the server. The script
// (src/shared/cart-page.ts) reads the store, asks `POST /cart/summary` to price the lines from D1
// and fills the template below with text nodes (names are admin-entered, never innerHTML).
// Four states, one visible at a time: loading, empty, error, ready. The prices shown are display
// only; checkout reads the real price again (ADR-0006).
//
// "Finalizar compra" links to the checkout of every line (`/checkout?line=...`, storefront-v2 11);
// the script sets its href and disables it while an unavailable line is in the cart.
// Copy comes from src/content/cart.ts and src/content/catalog-page.ts — see
// docs/agents/content-files.md.
import { Minus, Plus } from '@lucide/astro';
import BaseLayout from '../layouts/base-layout.astro';
import {
	checkoutLabel,
	continueHref,
	continueLabel,
	emptyCtaLabel,
	emptyMessage,
	errorMessage,
	linesLabel,
	loadingMessage,
	noscriptMessage,
	pageDescription,
	pageHeading,
	pageTitle,
	paymentMethodsNote,
	quantityLabel,
	removeLabel,
	retryLabel,
	totalLabel,
} from '../content/cart';
import { buyWithdrawalNote } from '../content/catalog-page';

const stepperButton =
	'inline-flex size-9 items-center justify-center rounded-sm border border-border-subtle text-text-primary transition-colors hover:bg-surface-overlay disabled:opacity-40 disabled:hover:bg-transparent';
const outlineButton =
	'button-h-sm inline-flex items-center justify-center rounded-sm border border-border-subtle px-5 text-body-sm font-medium text-text-primary transition-colors hover:bg-surface-overlay';
---

<BaseLayout title={pageTitle} description={pageDescription}>
	<section class="content-row gutter-x py-16 text-center sm:py-20">
		<h1 class="text-heading-1 font-bold text-text-primary">{pageHeading}</h1>
	</section>

	<section class="content-row gutter-x pb-20">
		<div data-cart-page tabindex="-1" class="mx-auto max-w-3xl outline-none">
			<p data-cart-state="loading" role="status" class="hidden py-10 text-center in-data-cart-ready:block text-body-lg text-text-secondary">
				{loadingMessage}
			</p>
			<noscript>
				<p class="py-10 text-center text-body-lg text-text-secondary">{noscriptMessage}</p>
			</noscript>

			<div data-cart-state="empty" hidden class="flex flex-col items-center gap-6 py-10 text-center">
				<p class="text-body-lg text-text-secondary">{emptyMessage}</p>
				<a
					href={continueHref}
					class="button-h-lg inline-flex items-center justify-center rounded-md bg-brand-primary px-6 text-body font-medium text-text-on-brand transition-colors hover:bg-brand-primary-hover"
				>
					{emptyCtaLabel}
				</a>
			</div>

			<div data-cart-state="error" hidden role="alert" class="flex flex-col items-center gap-6 py-10 text-center">
				<p class="text-body-lg text-text-secondary">{errorMessage}</p>
				<button type="button" data-cart-retry class={outlineButton}>{retryLabel}</button>
			</div>

			<div data-cart-state="ready" hidden>
				<ul data-cart-lines aria-label={linesLabel} role="list" class="flex flex-col gap-4"></ul>

				<div class="mt-8 border-t border-border-subtle pt-6">
					<p class="flex items-baseline justify-between gap-4">
						<span class="text-body-lg font-bold text-text-primary">{totalLabel}</span>
						<span
							data-cart-total
							aria-live="polite"
							class="whitespace-nowrap font-heading text-heading-2 font-bold text-text-primary"
						></span>
					</p>
					<p id="cart-unavailable-note" data-cart-unavailable-note hidden class="mt-3 text-body-sm text-danger"></p>
					<p class="mt-4 text-caption text-text-secondary">{paymentMethodsNote.value}</p>
					<p class="mt-2 text-caption text-text-secondary">
						{buyWithdrawalNote.text.value}{' '}
						<a href={buyWithdrawalNote.href} class="font-medium text-brand-primary underline">
							{buyWithdrawalNote.linkLabel}
						</a>
					</p>

					<div class="mt-6 flex flex-col gap-3 sm:flex-row sm:justify-between">
						<a href={continueHref} class={outlineButton}>{continueLabel}</a>
						<a
							data-cart-checkout
							aria-disabled="true"
							class="button-h-lg inline-flex items-center justify-center rounded-md bg-brand-primary px-6 text-body font-medium text-text-on-brand transition-colors hover:bg-brand-primary-hover aria-disabled:cursor-not-allowed aria-disabled:opacity-50 aria-disabled:hover:bg-brand-primary"
						>
							{checkoutLabel}
						</a>
					</div>
				</div>
			</div>
		</div>

		<!-- One line of the cart, cloned and filled by src/shared/cart-page.ts. -->
		<template data-cart-line-template>
			<li
				data-cart-line
				class="flex flex-col gap-4 rounded-lg border border-border-subtle bg-surface-raised p-5 data-unavailable:border-danger sm:flex-row sm:items-center sm:justify-between"
			>
				<div class="min-w-0">
					<p data-field="name" class="break-words text-body font-bold text-text-primary"></p>
					<p data-field="offer" class="text-caption text-text-secondary"></p>
					<p data-field="unavailable" hidden class="mt-1 text-caption text-danger"></p>
				</div>

				<div class="flex flex-wrap items-center gap-4 sm:flex-nowrap">
					<div data-field="stepper" role="group" aria-label={quantityLabel} class="flex items-center gap-2">
						<button type="button" data-action="decrease" class={stepperButton}>
							<Minus size={16} aria-hidden="true" />
						</button>
						<output data-field="quantity" class="min-w-6 text-center text-body font-medium text-text-primary"></output>
						<button type="button" data-action="increase" class={stepperButton}>
							<Plus size={16} aria-hidden="true" />
						</button>
					</div>

					<div data-field="prices" class="min-w-24 text-right">
						<p data-field="line-price" class="font-heading text-body-lg font-bold text-text-primary"></p>
						<p data-field="unit-price" class="text-caption text-text-secondary"></p>
					</div>

					<button
						type="button"
						data-action="remove"
						class="text-body-sm font-medium text-text-secondary underline transition-colors hover:text-text-primary"
					>
						{removeLabel}
					</button>
				</div>
			</li>
		</template>
	</section>
</BaseLayout>

<script>
	import { initCartPage } from '../shared/cart-page';

	initCartPage();
</script>
