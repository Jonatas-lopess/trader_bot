---
// FAQ section — src/components/faq-section.astro
//
// Landing page's final band (frame 6:160,
// .scratch/marketing-pages/issues/08-landing-plan-teaser-and-faq.md).
// Heading over five Q&A items, built as native <details>/<summary>
// disclosures — keyboard-operable and screen-reader-sane without any
// custom ARIA wiring, per the ticket's "not a div-only accordion"
// requirement.
//
// `id="faq"` matches the footer's "FAQ" link (src/content/footer.ts →
// usefulLinks, `/#faq`).
//
// Content comes from src/content/faq.ts — see docs/agents/content-files.md.
// Answers may be a launchBlocking-wrapped string; render `.value` and
// otherwise leave the wrapper alone.
import { ChevronDown } from '@lucide/astro';
import { heading, faqItems } from '../content/faq';
---

<section id="faq" class="content-row gutter-x py-16 sm:py-20 lg:py-28">
	<div class="mx-auto max-w-2xl text-center">
		<h2 class="text-heading-1 font-bold text-balance text-text-primary">
			{heading}
		</h2>
	</div>

	<div class="mx-auto mt-12 flex max-w-3xl flex-col gap-4">
		{
			faqItems.map((item) => {
				const answer = typeof item.answer === 'string' ? item.answer : item.answer.value;
				return (
					<details class="group rounded-lg border border-border-subtle bg-surface-raised px-6 py-4">
						<summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-body font-semibold text-text-primary marker:content-none">
							{item.question}
							<ChevronDown
								size={20}
								class="shrink-0 text-text-secondary transition-transform group-open:rotate-180"
							/>
						</summary>
						<p class="mt-3 text-body-sm text-text-secondary">{answer}</p>
					</details>
				);
			})
		}
	</div>
</section>
