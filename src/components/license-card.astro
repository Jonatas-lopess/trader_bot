---
// Licença product card — src/components/license-card.astro
//
// One lean card per Licença on `/conta` (.scratch/figma-restyle/issues/04-conta-restyle.md):
// icon tile, Robô name with its Oferta in mono, a status badge per Licença state, a compact data
// row, and the Corretora form / cancel control the state allows. Card pattern from the
// `painel-cliente` / `estados-licenca` wireframes; states the wireframes do not draw reuse it.
// Copy comes from src/content/conta.ts — see docs/agents/content-files.md. Behavior (form
// actions, data attributes) is unchanged; the confirmation is src/components/confirm-dialog.astro, driven by the `data-confirm-*` attributes.
import { CircleX, Cog, Hourglass, KeyRound, ShieldAlert, ShieldCheck } from '@lucide/astro';
import type { AccountLicense } from '../modules/licensing/account-page';
import {
	assinaturaLabel,
	assinaturaStatusTexts,
	cancelConfirmAccept,
	cancelConfirmMessage,
	cancelConfirmTitle,
	cancelLabel,
	corretoraAccountHint,
	corretoraAccountLabel,
	corretoraBannerBody,
	corretoraBannerHeading,
	corretoraConfirmAccept,
	corretoraConfirmMessage,
	corretoraConfirmTitle,
	corretoraDataEmpty,
	corretoraDataLabel,
	corretoraSubmitLabel,
	licenseBadges,
	licenseLabel,
	licenseStatusText,
	offerLabels,
	offerPrefix,
	rejectedNoticeText,
	type BadgeTone,
	type LicenseBadgeIcon,
} from '../content/conta';

type Props = {
	item: AccountLicense;
	robotName: string;
};

const { item, robotName } = Astro.props;

const icons: Record<LicenseBadgeIcon, typeof Hourglass> = {
	hourglass: Hourglass,
	'key-round': KeyRound,
	cog: Cog,
	'shield-check': ShieldCheck,
	'circle-x': CircleX,
	'shield-alert': ShieldAlert,
};

// Full class strings, so Tailwind's scanner sees every one.
const badgeToneClasses: Record<BadgeTone, string> = {
	success: 'bg-success-subtle text-success',
	danger: 'bg-danger-subtle text-danger',
	neutral: 'bg-surface-emphasis text-brand-primary',
};
const tileToneClasses: Record<BadgeTone, string> = {
	success: 'text-success',
	danger: 'text-danger',
	neutral: 'text-brand-primary',
};

const badge = licenseBadges[item.license.status];
const Icon = icons[badge.icon];
---

<article
	class:list={[
		'flex flex-col gap-4 rounded-lg border-w-1 border-border-subtle bg-surface-raised p-5 shadow-card',
		// The account form is the tall card; a full row keeps it from leaving a hole beside it.
		item.license.status === 'awaiting_account' && 'md:col-span-2',
	]}
	data-purchase-id={item.purchaseId}
>
	<div class="flex items-center gap-3">
		<span class={`flex size-10 shrink-0 items-center justify-center rounded-md bg-surface-emphasis ${tileToneClasses[badge.tone]}`}>
			<Icon size={20} aria-hidden="true" />
		</span>
		<div class="flex min-w-0 flex-col">
			<h3 class="text-body-lg font-bold text-text-primary">{robotName}</h3>
			<p class="font-mono text-caption uppercase text-text-secondary">{offerPrefix} {offerLabels[item.offer]}</p>
		</div>
	</div>

	<span
		class={`inline-flex w-fit items-center gap-1.5 rounded-xs px-2 py-1 font-mono text-caption ${badgeToneClasses[badge.tone]}`}
	>
		<Icon size={14} aria-hidden="true" />
		{badge.label}
	</span>

	{
		item.subscriptionStatus === 'rejected' && (
			<p class="rounded-md bg-surface-emphasis p-4 text-body-sm text-text-primary" role="status">
				{rejectedNoticeText.value}
			</p>
		)
	}

	{
		item.license.status === 'awaiting_account' && (
			<section
				class="flex flex-col gap-3 rounded-md border-w-1 border-border-accent bg-surface-sunken p-4"
				data-corretora-banner
			>
				<h4 class="text-body font-bold text-text-primary">{corretoraBannerHeading}</h4>
				<p class="text-body-sm text-text-secondary">{corretoraBannerBody}</p>
				<form
					method="POST"
					action="/conta/corretora"
					data-corretora-form
					data-confirm-title={corretoraConfirmTitle}
					data-confirm-message={corretoraConfirmMessage}
					data-confirm-accept={corretoraConfirmAccept}
					data-confirm-tone="primary"
					class="flex max-w-sm flex-col gap-3"
				>
					<input type="hidden" name="purchase_id" value={item.purchaseId} />
					<label class="flex flex-col gap-2">
						<span class="text-body-sm text-text-secondary">{corretoraAccountLabel}</span>
						<input
							type="text"
							name="corretora_account"
							inputmode="numeric"
							pattern="[1-9][0-9]{0,11}"
							required
							class="rounded-sm border-w-1 border-border-strong bg-surface-base px-4 py-2 font-mono text-body text-text-primary focus:border-border-accent focus:shadow-focus-ring focus:outline-none"
						/>
						<span class="text-body-sm text-text-secondary">{corretoraAccountHint}</span>
					</label>
					<button
						type="submit"
						class="button-h-sm inline-flex items-center justify-center rounded-md bg-brand-primary px-6 text-body-sm font-medium text-text-on-brand transition-colors hover:bg-brand-primary-hover"
					>
						{corretoraSubmitLabel}
					</button>
				</form>
			</section>
		)
	}

	<dl class="grid grid-cols-2 gap-x-4 gap-y-3 border-t border-border-subtle pt-4">
		<div class="col-span-2 flex flex-col gap-0.5">
			<dt class="text-body-sm text-text-secondary">{licenseLabel}</dt>
			<dd class="font-mono text-body-sm text-text-primary">{licenseStatusText(item.license)}</dd>
		</div>
		<div class="flex flex-col gap-0.5">
			<dt class="text-body-sm text-text-secondary">{assinaturaLabel}</dt>
			<dd class="font-mono text-body-sm text-text-primary">{assinaturaStatusTexts[item.subscriptionStatus]}</dd>
		</div>
		<div class="flex flex-col gap-0.5">
			<dt class="text-body-sm text-text-secondary">{corretoraDataLabel}</dt>
			<dd class="font-mono text-body-sm text-text-primary">{item.corretoraAccount ?? corretoraDataEmpty}</dd>
		</div>
	</dl>

	{
		item.canCancel && (
			<form
				method="POST"
				action="/conta/cancelar"
				data-cancel-form
				data-confirm-title={cancelConfirmTitle}
				data-confirm-message={cancelConfirmMessage}
				data-confirm-accept={cancelConfirmAccept}
				data-confirm-tone="danger"
			>
				<input type="hidden" name="purchase_id" value={item.purchaseId} />
				<button
					type="submit"
					class="button-h-sm inline-flex items-center justify-center rounded-md border-w-1 border-border-strong px-5 text-body-sm font-medium text-text-primary transition-colors hover:bg-surface-overlay"
				>
					{cancelLabel}
				</button>
			</form>
		)
	}
</article>
